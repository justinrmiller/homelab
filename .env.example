# Copy to .env and adjust:  cp .env.example .env
#
# .env is gitignored. Never commit real credentials — the previous .env was
# tracked in git and has been removed from the index.

# --- Network exposure -----------------------------------------------------
# Which interface published ports bind to. 0.0.0.0 exposes every service to
# your LAN; 127.0.0.1 keeps them on this host only. Several services below
# ship with development credentials, so prefer 127.0.0.1 unless you need
# access from another machine.
BIND_ADDR=127.0.0.1

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# Optional non-root user created by init-data.sh. Leave blank to skip.
POSTGRES_NON_ROOT_USER=app
POSTGRES_NON_ROOT_PASSWORD=change-me

# --- Grafana --------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# --- Hasura ---------------------------------------------------------------
# REQUIRED — there is no default. The stack refuses to start if this is unset,
# because port 8080 would otherwise be unauthenticated read/write access to
# Postgres over GraphQL. `make up` also rejects the placeholder below.
HASURA_GRAPHQL_ADMIN_SECRET=change-me

# --- Floci (local AWS emulator) -------------------------------------------
# Floci accepts any credentials. These are placeholders for the local
# emulator, not real AWS keys — do not put real ones here.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# Only needed when running the dashboard outside the compose network
# (`make dev`); inside compose this is set to http://floci:4566.
AWS_ENDPOINT_URL=http://localhost:4566
