# Copy to .env and adjust:  cp .env.example .env
#
# .env is gitignored. Never commit real credentials — the previous .env was
# tracked in git and has been removed from the index.

# --- Network exposure -----------------------------------------------------
# Which interface published ports bind to. 0.0.0.0 reaches the stack from
# anywhere on your LAN, which is what a homelab is for and what the benchmarks
# in benchmark/ need.
#
# Read this before using it on an untrusted network: every service below ships
# with development credentials, so 0.0.0.0 publishes Postgres, Kafka, Valkey,
# Grafana, Hasura and the S3 emulator to every host that can route to you.
# Change the passwords in this file, or set BIND_ADDR=127.0.0.1 to keep the
# stack on this machine only.
BIND_ADDR=0.0.0.0

# --- Reaching the stack from another machine ------------------------------
# Kafka needs one thing more than a bind address: after bootstrap it tells the
# client which address to reconnect to, and that address has to resolve for the
# client. Unset, it hands out "localhost", so a client on another machine dials
# its own loopback and waits until it gives up.
#
# Set this to this machine's hostname or LAN address, then `make restart`.
# Leave it commented for single-host use.
# KAFKA_ADVERTISED_HOST=my-host.local

# Floci embeds this in the URLs it returns. Only needed if clients outside the
# compose network have to follow them; ordinary S3 calls work without it.
# FLOCI_HOSTNAME=my-host.local

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# Optional non-root user created by init-data.sh. Leave blank to skip.
POSTGRES_NON_ROOT_USER=app
POSTGRES_NON_ROOT_PASSWORD=change-me

# --- Grafana --------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# Where the dashboard's "open" link should send your browser. The health check
# reaches Grafana over the compose network instead, so only change this if you
# browse the stack from another host or through a proxy.
GRAFANA_PUBLIC_URL=http://localhost:3000

# --- Hasura ---------------------------------------------------------------
# REQUIRED — there is no default. The stack refuses to start if this is unset,
# because port 8080 would otherwise be unauthenticated read/write access to
# Postgres over GraphQL. `make up` also rejects the placeholder below.
HASURA_GRAPHQL_ADMIN_SECRET=change-me

# --- Floci (local AWS emulator) -------------------------------------------
# Floci accepts any credentials. These are placeholders for the local
# emulator, not real AWS keys — do not put real ones here.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# Only needed when running the dashboard outside the compose network
# (`make dev`); inside compose this is set to http://floci:4566.
AWS_ENDPOINT_URL=http://localhost:4566
