{
  "uid": "homelab-postgres-overview",
  "title": "PostgreSQL Overview",
  "description": "Live PostgreSQL activity from pg_stat_database. Works against any database with no extensions required.",
  "tags": ["homelab", "postgresql"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Connections",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "homelab-postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT numbackends AS \"Connections\" FROM pg_stat_database WHERE datname = current_database();",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "homelab-postgres" }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Database Size",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "homelab-postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT pg_database_size(current_database()) AS \"Size\";",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "homelab-postgres" }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache Hit Ratio",
      "description": "Share of block reads served from shared buffers rather than disk. Sustained low values suggest shared_buffers is undersized.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "homelab-postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 90 },
              { "color": "green", "value": 98 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN blks_hit + blks_read = 0 THEN 100 ELSE round(100.0 * blks_hit / (blks_hit + blks_read), 2) END AS \"Cache Hit Ratio\" FROM pg_stat_database WHERE datname = current_database();",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "homelab-postgres" }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "homelab-postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "fixed", "fixedColor": "purple" }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM (now() - pg_postmaster_start_time())) AS \"Uptime\";",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "homelab-postgres" }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connections",
      "description": "Sampled each time the dashboard refreshes, so the series builds up while the dashboard is open.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "homelab-postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "auto",
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT now() AS time, numbackends AS \"connections\" FROM pg_stat_database WHERE datname = current_database();",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "homelab-postgres" }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Transactions",
      "description": "Cumulative commit and rollback counters since the last stats reset.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "homelab-postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 5
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "rollbacks" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT now() AS time, xact_commit AS \"commits\", xact_rollback AS \"rollbacks\" FROM pg_stat_database WHERE datname = current_database();",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "homelab-postgres" }
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "All Databases",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "homelab-postgres" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Size" },
            "properties": [{ "id": "custom.align", "value": "right" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT datname AS \"Database\", numbackends AS \"Connections\", xact_commit AS \"Commits\", xact_rollback AS \"Rollbacks\", blks_hit AS \"Cache Hits\", blks_read AS \"Disk Reads\", tup_inserted AS \"Inserted\", tup_updated AS \"Updated\", tup_deleted AS \"Deleted\", pg_size_pretty(pg_database_size(datname)) AS \"Size\" FROM pg_stat_database WHERE datname IS NOT NULL AND datname NOT LIKE 'template%' ORDER BY datname;",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "homelab-postgres" }
        }
      ]
    }
  ]
}
